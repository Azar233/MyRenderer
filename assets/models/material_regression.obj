# Fixed stage-4 regression asset: external texture, constant material, and
# deliberately missing texture. All faces point toward +Z.
mtllib material_regression.mtl

o ExternalTextureQuad
v -1.55 -0.50 0.0
v -0.55 -0.50 0.0
v -0.55  0.50 0.0
v -1.55  0.50 0.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vn 0.0 0.0 1.0
usemtl ExternalUvTexture
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1

o ConstantColorQuad
v -0.50 -0.50 0.0
v  0.50 -0.50 0.0
v  0.50  0.50 0.0
v -0.50  0.50 0.0
usemtl ConstantGreen
f 5/1/1 6/2/1 7/3/1
f 5/1/1 7/3/1 8/4/1

o MissingTextureQuad
v 0.55 -0.50 0.0
v 1.55 -0.50 0.0
v 1.55  0.50 0.0
v 0.55  0.50 0.0
usemtl MissingTexture
f 9/1/1 10/2/1 11/3/1
f 9/1/1 11/3/1 12/4/1
